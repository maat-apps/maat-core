{
  "name": "maat-core",
  "lockfileVersion": 3,
  "requires": true,
  "packages": {
    "": {
      "name": "maat-core",
      "workspaces": [
        "packages/*"
      ],
      "engines": {
        "node": ">=24",
        "npm": ">=11"
      }
    },
    "node_modules/@maat-apps/create-maat-app": {
      "resolved": "packages/create-maat-app",
      "link": true
    },
    "node_modules/@maat-apps/placeholder": {
      "resolved": "packages/placeholder",
      "link": true
    },
    "packages/create-maat-app": {
      "name": "@maat-apps/create-maat-app",
      "version": "0.1.0",
      "license": "MIT",
      "bin": {
        "create-maat-app": "bin/cli.mjs"
      },
      "engines": {
        "node": ">=24"
      }
    },
    "packages/placeholder": {
      "name": "@maat-apps/placeholder",
      "version": "0.0.2",
      "license": "MIT"
    }
  }
}
