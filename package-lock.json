{
  "name": "maat-core",
  "lockfileVersion": 3,
  "requires": true,
  "packages": {
    "": {
      "name": "maat-core",
      "workspaces": [
        "packages/*"
      ],
      "engines": {
        "node": ">=24",
        "npm": ">=11"
      }
    },
    "node_modules/@maat-apps/placeholder": {
      "resolved": "packages/placeholder",
