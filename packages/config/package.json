{
  "name": "@maat-apps/config",
  "version": "0.2.0",
  "description": "Shared ESLint, Prettier, TypeScript, Vite, Vitest and Playwright configs and helpers for maat-apps repos, with the plugins they load as dependencies.",
  "type": "module",
  "license": "MIT",
  "files": [
    "eslint.mjs",
    "prettier.mjs",
    "tsconfig.base.json",
    "vite.mjs",
    "vite.d.mts",
    "vitest.mjs",
    "vitest.d.mts",
    "vitest-setup.mjs",
    "playwright.mjs",
    "playwright.d.mts"
  ],
  "exports": {
    "./eslint": "./eslint.mjs",
    "./prettier": "./prettier.mjs",
    "./tsconfig.base.json": "./tsconfig.base.json",
    "./vite": {
      "types": "./vite.d.mts",
      "import": "./vite.mjs"
    },
    "./vitest": {
      "types": "./vitest.d.mts",
      "import": "./vitest.mjs"
    },
    "./vitest-setup": "./vitest-setup.mjs",
    "./playwright": {
      "types": "./playwright.d.mts",
      "import": "./playwright.mjs"
    }
  },
  "peerDependencies": {
    "@playwright/test": "^1",
    "@tailwindcss/postcss": "^4",
    "@testing-library/react": "^16",
    "@vitejs/plugin-react": "^5",
    "eslint": "^10",
    "fake-indexeddb": "^6",
    "prettier": "^3",
    "typescript": "^5",
    "vite": "^7",
    "vite-plugin-pwa": "^1",
    "vitest": "^5"
  },
  "peerDependenciesMeta": {
    "@playwright/test": {
      "optional": true
    },
    "@tailwindcss/postcss": {
      "optional": true
    },
    "@testing-library/react": {
      "optional": true
    },
    "@vitejs/plugin-react": {
      "optional": true
    },
    "fake-indexeddb": {
      "optional": true
    },
    "vite": {
      "optional": true
    },
    "vite-plugin-pwa": {
      "optional": true
    },
    "vitest": {
      "optional": true
    }
  },
  "dependencies": {
    "@eslint/js": "^9.39.5",
    "eslint-config-prettier": "^10.1.8",
    "eslint-plugin-prettier": "^5.5.6",
    "eslint-plugin-react-hooks": "^7.1.1",
    "eslint-plugin-react-refresh": "^0.4.26",
    "globals": "^16.5.0",
    "prettier-plugin-organize-imports": "^4.3.0",
    "prettier-plugin-tailwindcss": "^0.8.1",
    "typescript-eslint": "^8.70.1"
  },
  "repository": {
    "type": "git",
    "url": "git+https://github.com/maat-apps/maat-core.git",
    "directory": "packages/config"
  }
}
