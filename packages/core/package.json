{
  "name": "@maat-apps/core",
  "version": "0.4.1",
  "description": "Browser-platform plumbing shared by maat-apps apps: storage, encryption, validation, backups, i18n, service worker, app lock, app update and install prompt. Only /i18n and /install use React.",
  "type": "module",
  "license": "MIT",
  "files": [
    "dist"
  ],
  "sideEffects": false,
  "exports": {
    "./backup": {
      "types": "./dist/backup.d.ts",
      "import": "./dist/backup.js"
    },
    "./crypto": {
      "types": "./dist/crypto.d.ts",
      "import": "./dist/crypto.js"
    },
    "./i18n": {
      "types": "./dist/i18n.d.ts",
      "import": "./dist/i18n.js"
    },
    "./install": {
      "types": "./dist/install.d.ts",
      "import": "./dist/install.js"
    },
    "./lock": {
      "types": "./dist/lock.d.ts",
      "import": "./dist/lock.js"
    },
    "./locale": {
      "types": "./dist/locale.d.ts",
      "import": "./dist/locale.js"
    },
    "./persisted": {
      "types": "./dist/persisted.d.ts",
      "import": "./dist/persisted.js"
    },
    "./storage": {
      "types": "./dist/storage.d.ts",
      "import": "./dist/storage.js"
    },
    "./sw": {
      "types": "./dist/sw.d.ts",
      "import": "./dist/sw.js"
    },
    "./update": {
      "types": "./dist/update.d.ts",
      "import": "./dist/update.js"
    },
    "./validation": {
      "types": "./dist/validation.d.ts",
      "import": "./dist/validation.js"
    }
  },
  "scripts": {
    "build": "tsup",
    "typecheck": "tsc --noEmit",
    "test": "vitest run"
  },
  "peerDependencies": {
    "react": "^19",
    "valibot": "^1.1.0"
  },
  "peerDependenciesMeta": {
    "react": {
      "optional": true
    },
    "valibot": {
      "optional": true
    }
  },
  "devDependencies": {
    "@types/react": "^19",
    "fake-indexeddb": "^6.2.5",
    "react": "^19",
    "tsup": "^8",
    "typescript": "^5",
    "valibot": "^1.1.0"
  },
  "publishConfig": {
    "access": "public"
  },
  "repository": {
    "type": "git",
    "url": "git+https://github.com/maat-apps/maat-core.git",
    "directory": "packages/core"
  }
}
