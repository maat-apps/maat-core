{
  "name": "@maat-apps/core",
  "version": "0.1.0",
  "description": "Browser-platform plumbing shared by maat-apps apps: IndexedDB key-value storage and WebAuthn PRF encryption. No React.",
  "type": "module",
  "license": "MIT",
  "files": [
    "dist"
  ],
  "sideEffects": false,
  "exports": {
    "./crypto": {
      "types": "./dist/crypto.d.ts",
      "import": "./dist/crypto.js"
    },
    "./storage": {
      "types": "./dist/storage.d.ts",
      "import": "./dist/storage.js"
    }
  },
  "scripts": {
    "build": "tsup",
    "typecheck": "tsc --noEmit",
    "test": "vitest run"
  },
  "devDependencies": {
    "fake-indexeddb": "^6.2.5",
    "tsup": "^8",
    "typescript": "^5"
  },
  "publishConfig": {
    "access": "public"
  },
  "repository": {
    "type": "git",
    "url": "git+https://github.com/maat-apps/maat-core.git",
    "directory": "packages/core"
  }
}
